{
  "mcpServers": {
    "google-search-console": {
      "command": "npx",
      "args": ["-y", "github:CristhianBuiza/mcp-google-search-console"],
      "env": {
        "GSC_CLIENT_ID": "${GSC_CLIENT_ID}",
        "GSC_CLIENT_SECRET": "${GSC_CLIENT_SECRET}",
        "GSC_READONLY": "${GSC_READONLY}"
      }
    }
  }
}
