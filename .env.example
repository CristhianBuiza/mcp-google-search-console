# OAuth client (type "Desktop app") from Google Cloud Console.
# Option A: client id + secret
GSC_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GSC_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Option B: path to the client_secret_*.json you downloaded (used if A is not set)
# Canonical local path used by this machine:
# GSC_CREDENTIALS_FILE=/home/cbuiza/.config/google-oauth/client_secret.json

# Where the OAuth token (refresh token) is stored. Default: ~/.config/mcp-google-search-console/token.json
# GSC_TOKEN_PATH=/absolute/path/to/token.json

# Alternative to the token file: provide the refresh token directly (e.g. in containers)
# GSC_REFRESH_TOKEN=

# Set to "true" to request only the read-only scope and hide write tools
# (add/delete site, submit/delete sitemap). Default: false
# GSC_READONLY=false
